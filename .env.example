# MyCrop configuration. Every key is optional for local development —
# the tools that do not need it keep working without it.

# Port the Express server binds to. Most hosts inject this themselves.
PORT=3000

# Google Gemini: enables the AI agronomist chat and the AI-written summaries.
# Without it, those tools fall back to direct calculation and say so.
GEMINI_API_KEY=

# Google Maps Platform: enables the interactive map pickers.
# Read by the client at build time, so it must carry the VITE_ prefix.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Firebase (Auth + Firestore) for saved fields lives in firebase-config.json.
# That file holds a public web API key, not a secret. With no Firebase
# configuration the app runs signed-out: location-based tools work, saving
# fields is disabled.
