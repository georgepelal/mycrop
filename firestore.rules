rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure Parcels Collection
    match /parcels/{parcelId} {
      // ownerId is the only ownership field. userId is set by the client and was
      // never checked on create, so it must not grant read access.
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;

      allow update: if request.auth != null 
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Diagnostics Subcollection under Parcel
      match /diagnostics/{diagnosticId} {
        allow read, list, delete: if request.auth != null && get(/databases/$(database)/documents/parcels/$(parcelId)).data.ownerId == request.auth.uid;
        allow create, update: if request.auth != null 
                              && get(/databases/$(database)/documents/parcels/$(parcelId)).data.ownerId == request.auth.uid
                              && request.resource.data.parcelId == parcelId;
      }
    }

    // Secure Crops Collection
    match /crops/{cropId} {
      allow read, list: if request.auth != null;
      // Shared catalogue: any signed-in user could previously overwrite any crop
      // for everyone. Nothing in the app writes it; seed it from the console
      // or the Admin SDK (which bypasses rules).
      allow write: if false;
    }
  }
}
