rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure Parcels Collection
    match /parcels/{parcelId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;

      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Diagnostics Subcollection under Parcel
      match /diagnostics/{diagnosticId} {
        allow read, list, delete: if request.auth != null && get(/databases/$(database)/documents/parcels/$(parcelId)).data.userId == request.auth.uid;
        allow create, update: if request.auth != null 
                              && get(/databases/$(database)/documents/parcels/$(parcelId)).data.userId == request.auth.uid
                              && request.resource.data.parcelId == parcelId;
      }
    }

    // Secure Crops Collection
    match /crops/{cropId} {
      allow read, list: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 100
                            && request.resource.data.icon is string
                            && request.resource.data.icon.size() <= 10;
      allow delete: if false;
    }
  }
}
